# Vorlage für die Umgebungsvariablen. Kopieren nach .env.local (lokal) bzw. in Vercel unter
# Project → Settings → Environment Variables eintragen.

# Zugriffscode für DICH: öffnet die komplette Lern-App (mind. 8 Zeichen, gern auch Buchstaben).
ACCESS_CODE=

# Zugriffscode für deinen AUSBILDER: öffnet nur die schreibgeschützte Ansicht /ausbilder.
# Muss sich vom ACCESS_CODE unterscheiden. Leer lassen = kein Ausbilder-Zugang.
TRAINER_CODE=

# Zufälliger geheimer Schlüssel (mind. 32 Zeichen) zum Signieren des Freischalt-Cookies.
# Erzeugen z. B. mit:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Ändert man einen Code, sind die Geräte dieser Rolle wieder gesperrt; ändert man AUTH_SECRET, alle.
AUTH_SECRET=

# Cloud-Speicher für die Ausbilder-Ansicht (Upstash Redis).
# Bei Vercel setzt die Upstash-Integration diese Werte automatisch – nicht selbst eintragen.
# Je nach Integration heißen sie KV_REST_API_URL / KV_REST_API_TOKEN – beides funktioniert.
# Ohne diese Werte läuft die App normal, nur der Upload für den Ausbilder wird übersprungen.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
